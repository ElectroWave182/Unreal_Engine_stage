FSplatData GetSplatScale(FVertexFactoryIntermediates Intermediates, FSplatData Data, uint Offset)
{
#if LCC_USE_POINT_CLOUD
    float3 ElevationColor = float3(lerp(ElevationColorBottom, ElevationColorTop, clamp((Data.Position.z - Elevation.x) / (Elevation.y - Elevation.x), 0, 1)));
    Data.Color = float4(HSV2RGB(ElevationColor),Intermediates.GlobalAlpha);
#else
    LIXEL_LCC2_SPLATTRANSFORM_IMPLE
#endif


    
    return Data;
}

