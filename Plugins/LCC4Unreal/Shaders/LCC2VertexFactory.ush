}

float4 DecodeRotation(uint enc)
{
    float4 pq = float4(
        (enc & 255) / fpb,
        ((enc >> 8) & 255) / fpb,
        ((enc >> 16) & 255) / fpb,
        ((enc >> 24) & 255) / fpb);
    uint idx = (uint(pq.w * fpb) - 252u) & 0x3u;
    float4 q;
    q.xyz = pq.xyz * SQRT2 - InvSQRT2;
    q.w = sqrt(1.0 - saturate(dot(q.xyz, q.xyz)));
    float4 p = float4(q[QLut[idx * 4]], q[QLut[idx * 4 + 1]], q[QLut[idx * 4 + 2]], q[QLut[idx * 4 + 3]]);
    return p.yzwx;
}

float3 HSV2RGB(float3 HSV)
{
    float h = HSV.x; // hue
    float s = HSV.y; // Saturation [0, 1]
    float v = HSV.z; // Value [0, 1]    

    float C = v * s;
    float X = C * (1 - abs((h / 60) % 2 - 1));
    float m = v - C;

    float3 RGB = 0;
    if (h >= 0 && h < 60)
    {
        RGB.r = C;
        RGB.g = X;
    }
    else if (h >= 60 && h < 120)
    {
        RGB.r = X;
        RGB.g = C;
    }
    else if (h >= 120 && h < 180)
    {
        RGB.g = C;
        RGB.b = X;
    }
    else if (h >= 180 && h < 240)
    {
        RGB.g = X;
        RGB.b = C;
    }
    else if (h >= 240 && h < 300)
    {
        RGB.r = X;
        RGB.b = C;
    }
    else if (h >= 300 && h < 360)
    {
        RGB.r = C;
        RGB.b = X;
    }

    RGB += m;
    return RGB;
}

