    {
        "id": "5fe4da68049824a3",
        "type": "function",
        "z": "9da9de4d95375b09",
        "name": "function 1",
        "func": "const mqtt = msg. mqtt;\n\nconst WebSocket = msg. ws;\n\n\n\n\n\n// =========================\n\n// 1. CONFIG HIVE MQ\n\n// =========================\n\nconst MQTT_HOST = \"mqtt://52c78340daef4e57a35c503e8d20343d.s1.eu.hivemq.cloud\";\n\nconst MQTT_OPTIONS = {\n\n    username: \"inp-hololens\",\n\n    password: \"!!.d6Rrh.bh3QwL4\",\n\n};\n\n\n\n\n\n// =========================\n\n// 2. WEBSOCKET SERVER (UNREAL)\n\n// =========================\n\nconst wss = new WebSocket.Server({ port: 8080 });\n\n\n\nwss.on('connection', (ws) => {\n\n    msg. a = \"Unreal connecté via WebSocket\";\n\n});\n\n\n\n\n\n// =========================\n\n// 3. MQTT CLIENT\n\n// =========================\n\nconst client = mqtt.connect(MQTT_HOST, MQTT_OPTIONS);\n\n\n\nclient.on('connect', () => {\n\n    msg. b = \"connecté\";\n\n\n\n    // 👉 ton topic Unity\n\n    client.subscribe(\"TestUnreal\");\n\n});\n\n\n\n\n\nclient.on('message', (topic, message) => {\n\n    const payload = message.toString();\n\n\n\n    msg. c = \"MQTT reçu\";\n\n\n\n    // broadcast vers Unreal\n\n    wss.clients.forEach(client => {\n\n        if (client.readyState === WebSocket.OPEN) {\n\n            client.send(payload);\n\n        }\n\n    });\n\n});",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 200,
        "wires": [
            [
                "b43630334c7f5ea6"
            ]
        ]
