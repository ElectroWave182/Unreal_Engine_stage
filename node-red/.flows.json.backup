    {
        "id": "62e688f277e8261a",
        "type": "function",
        "z": "680b9f61ad2a9397",
        "name": "tcpSocket",
        "func": "var net = msg. module;\nvar client = new net. Socket ();\nvar rotations = msg. payload. map (function (nb) {\n    return ((180 - nb) % 360 - 180) * Math. PI / 180;\n});\n\n// La liaison \"wrist 2\" est inversée\nrotations [4] *= -1;\n\nmsg. commande =\n    \"movej([\"\n    + rotations\n    + \"], a=1.4, v=1.05, t=0, r=0)\"\n    + '\\n'\n;\n\nclient. on (\"error\", function (erreur) {\n    client. destroy ();\n    client = null;\n    msg. retour = \"Erreur : \" + erreur. message;\n});\n\nclient. on (\"data\", function (donnees) {\n    msg. retour = \"Données : \" + donnees;\n});\n\nclient. connect (30*1000 + 3, msg. host, function () {\n    msg. retour = \"Connecté\";\n});\n\nclient. write (msg. commande);\n/*\nclient.destroy();\nclient = null;\n*/\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 200,
        "wires": [
            [
                "a5722af5446be11e",
                "ebe4625e19877efd"
            ]
        ]
    },
    {
        "id": "f099aad0fca9e788",
