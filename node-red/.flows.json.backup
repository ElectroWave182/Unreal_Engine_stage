    {
        "id": "e93750f98bb0da49",
        "type": "function",
        "z": "fd89d7dfc851fc61",
        "name": "statutMisAJour",
        "func": "msg. protocole = msg. status. source. name;\nmsg. payload. niveaux [msg. protocole] = msg. niveau;\nlet protocolePrecedent = msg. payload. protocole;\n\nmsg. maj =\n    msg. protocole == protocolePrecedent ||\n    msg. niveau > msg. payload. niveaux [protocolePrecedent]\n;\n\nif (msg. maj)\n    msg. payload. protocole = msg. protocole;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 80,
        "wires": [
            [
                "c904e80e34496088"
            ]
        ]
    },
    {
        "id": "e3e15a08a8dfcf75",
