    {
        "id": "2fc51764341f4133",
        "type": "function",
        "z": "19d44862905ad910",
        "name": "degresLiberteObtenir",
        "func": "let listeLiaisons = msg. donnees. jointData;\nvar listeDegres = new Array ();\n\nlisteLiaisons. forEach (function (degreLiberte) {\n    listeDegres. push (degreLiberte. positionTargetDegree);\n});\n\n// La liaison \"wrist 2\" est inversée\nlisteDegres [4] *= -1;\n\nmsg. payload = {decalages: listeDegres};\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 260,
        "y": 300,
